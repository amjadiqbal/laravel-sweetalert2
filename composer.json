{
    "name": "amjadiqbal/laravel-sweetalert2",
    "description": "SweetAlert2 for Laravel: flash success, error and toast popups from controllers, fire them from Livewire or Alpine, and confirm deletes with a data attribute. SweetAlert2 11, no jQuery, CSP nonce aware.",
    "keywords": [
        "laravel",
        "laravel-package",
        "sweetalert2",
        "sweetalert",
        "sweet-alert",
        "alert",
        "popup",
        "modal",
        "toast",
        "notification",
        "flash-message",
        "confirm-dialog",
        "livewire",
        "alpinejs",
        "blade"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/amjadiqbal/laravel-sweetalert2",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-sweetalert2/issues",
        "source": "https://github.com/amjadiqbal/laravel-sweetalert2",
        "docs": "https://github.com/amjadiqbal/laravel-sweetalert2#readme"
    },
    "require": {
        "php": "^8.3",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\SweetAlert2\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\SweetAlert2\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\SweetAlert2\\SweetAlert2ServiceProvider"
            ],
            "aliases": {
                "SweetAlert2": "AmjadIqbal\\SweetAlert2\\Facades\\SweetAlert2"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
